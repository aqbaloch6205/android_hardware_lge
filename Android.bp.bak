soong_namespace {
}

// THIS IS THE UNIVERSAL COMMANDER
cc_binary {
    name: "lge_universal_hardware_service",
    vendor: true,
    relative_install_path: "hw",
    
    // BAKES EVERYTHING IN: The secret for A11-A16 compatibility
    stl: "libc++_static", 

    // THE MAGIC GLOB: Finds every source file in every subfolder automatically
    srcs: [
        "**/*.cpp",
        "**/*.c",
    ],

    // Finds all header files (.h) in all subfolders
    export_include_dirs: ["."],
    local_include_dirs: [
        "interfaces/**",
        "hidl/**",
        "amplifier/**",
        "sensors/**",
        "dac_panel/**",
    ],

    // STATIC LIBS: Bakes these libraries into your binary so it's a "Fat Binary"
    static_libs: [
        "libbase",
        "libhidlbase",
        "libutils",
        "libcutils",
        // Automatically links the HIDL interfaces generated by your subfolders
        "vendor.lge.hardware.audio.dac.control@2.0",
        // Add other interface names here if you have more (e.g. amplifier@1.0)
    ],

    // CORE SHARED LIBS: These are the only things it will ask the OS for
    shared_libs: [
        "liblog",
        "libc",
        "libm",
        "libdl",
    ],

    // CLEANER LINKING: Prevents "Symbol already defined" errors on A15/A16
    ldflags: ["-Wl,--exclude-libs,ALL"],
}
